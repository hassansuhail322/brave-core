<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto application descriptor for Brave.

  Declaring this descriptor (referenced from the application level
  "com.google.android.gms.car.application" meta-data) makes Android Auto
  aware that Brave is an Android Auto capable application. The app still has
  to be allowed through Android Auto's developer settings ("Unknown sources")
  because it is not distributed through an approved car app channel.

  The "media" use entry matches the reference implementation (AA Browser) and
  keeps Brave eligible for the car launcher on Android Auto builds that only
  enumerate apps with an automotive descriptor.
-->
<automotiveApp xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <uses name="media" />
</automotiveApp>
